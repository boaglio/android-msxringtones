# Settings for tools/android-release.sh. Copy this file to release.env, which git ignores, and fill it in.
# Put a value in single quotes if it has spaces or characters like $ & ! # in it.

# The Android SDK.
ANDROID_HOME=/path/to/android-sdk

# Your signing key: the upload key if the app uses Play App Signing, otherwise the app's original key.
# A relative path starts at the repository; keep the keystore out of it if you can.
ANDROID_KEYSTORE_FILE=/path/to/your.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# The SHA1 of the key Google Play expects (Play Console → Test and release → App integrity). The script stops
# if your key doesn't match it. This is the original MSX Ringtones key; change it if you move to a new upload key.
ANDROID_EXPECTED_SHA1=29:03:9E:B7:31:D0:83:6D:28:63:F1:CC:A0:17:EC:4E:8E:93:F2:15

# Java 21 or newer. Leave this out to use the one on your PATH.
#JAVA_HOME=/path/to/jdk
