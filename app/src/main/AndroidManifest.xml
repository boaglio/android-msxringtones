<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to set the default ringtone. Granted by the user in system settings
         (Settings.ACTION_MANAGE_WRITE_SETTINGS), not via the runtime permission dialog. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only needed on Android 9 and below; Android 10+ writes via MediaStore without it. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- No backups: the only local data (which sounds were set) must stay on the device.
         allowBackup=false covers Android 11 and older, so fullBackupContent isn't needed. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MSX">
        <!-- Class name kept from 1.x so existing home-screen shortcuts keep working. -->
        <activity
            android:name=".MSXringtonesActivity"
            android:exported="true"
            android:theme="@style/Theme.MSX.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
