<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to set the default ringtone. Granted by the user in system settings
         (Settings.ACTION_MANAGE_WRITE_SETTINGS), not via the runtime permission dialog. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only needed on Android 9 and below; Android 10+ writes via MediaStore without it. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name">
        <activity
            android:name=".MSXringtonesActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MSX1ringtonesActivity"
            android:label="MSX1" />
        <activity
            android:name=".MSX2ringtonesActivity"
            android:label="MSX2" />
        <activity
            android:name=".SobreActivity"
            android:label="sobre" />
    </application>

</manifest>
